# CentrAlign AI — Autonomous AI Task Worker Configuration

# LLM Providers (Set whichever key you use; or leave blank to use the offline engine)
# 1. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 3. Anthropic
ANTHROPIC_API_KEY=
